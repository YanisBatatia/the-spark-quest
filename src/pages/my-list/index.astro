---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExperienceCard from '../../components/ExperienceCard.astro';
import Decorations from '../../components/Decorations.astro';

const ideas = (await getCollection('experiences')).sort((a, b) => a.id.localeCompare(b.id));
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="My list">
  <section class="my-list page-frame">
    <Decorations variant="list" />
    <div class="list-heading-row">
      <div>
        <h1 class="section-heading">Your saved sparks</h1>
        <p class="lead">A little collection of possibilities. Keep what calls to you, and change it whenever you like.</p>
      </div>
      <div class="list-actions" data-list-actions hidden>
        <button class="button button-outline" type="button" data-export-list>⇧ &nbsp;Export list</button>
        <button class="button button-outline" type="button" data-print-list>▣ &nbsp;Print</button>
      </div>
    </div>
    <div class="empty-list" data-empty-list>
      <h2>Start wherever curiosity takes you.</h2>
      <p>Save an idea that makes you pause, even for a moment. You can change this list anytime.</p>
      <a class="button button-primary" href={`${base}explore/`}>Explore ideas <span aria-hidden="true">→</span></a>
    </div>
    <div class="saved-list" data-saved-list>
      {ideas.map((idea) => <ExperienceCard idea={idea} variant="saved" />)}
    </div>
    <div class="list-footer" data-list-actions hidden><a class="button button-primary" href={`${base}explore/`}>Explore more ideas <span aria-hidden="true">→</span></a></div>
  </section>
</BaseLayout>
