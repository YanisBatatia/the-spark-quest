---
import ExperienceImage from './ExperienceImage.astro';
import SaveButton from './SaveButton.astro';

const { idea, index = 0, variant = 'explore' } = Astro.props;
const { id, data } = idea;
const base = import.meta.env.BASE_URL;
const href = `${base}experiences/${id}/`;
---
<article
  class:list={['experience-card', { 'saved-card': variant === 'saved' }]}
  data-experience-id={id}
  data-search={`${data.title} ${data.location.label} ${data.teaser}`}
  data-moods={data.moods.join(' ')}
  data-place={data.location.placeGroup}
  data-title={data.title}
  data-location={data.location.label}
  data-href={href}
  data-saved-item={variant === 'saved' ? '' : undefined}
  hidden={variant === 'saved'}
>
  <a href={href} class="card-image-link" aria-label={`Read about ${data.title}`}>
    <ExperienceImage id={id} title={data.title} priority={variant === 'explore' && index < 3} />
  </a>
  {variant === 'explore' && <div class="card-save"><SaveButton id={id} title={data.title} /></div>}
  <div class="card-body">
    <a href={href} class="card-title">{data.title}</a>
    <div class="card-meta">
      <span class="card-location"><span aria-hidden="true">●</span> {data.location.label}</span>
      <span class="card-id">{id}</span>
    </div>
    {variant === 'explore' && <p class="card-teaser">{data.teaser}</p>}
    {variant === 'saved' && <button type="button" class="remove-link" data-remove-id={id}>Remove</button>}
  </div>
</article>
