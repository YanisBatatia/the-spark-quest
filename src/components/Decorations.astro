---
const { variant } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<div class={`page-art page-art-${variant}`} aria-hidden="true">
  <img class="art-botanical" src={`${base}decor/botanical.svg`} alt="" width="320" height="440" loading="lazy" />
  <img class="art-landscape" src={`${base}decor/landscape.svg`} alt="" width="640" height="260" loading="lazy" />
</div>
